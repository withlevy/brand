---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionShell from '../../components/layout/SectionShell.astro';
import VerticalLabel from '../../components/typography/VerticalLabel.astro';
import DimensionLabel from '../../components/typography/DimensionLabel.astro';
import { getCollection, render } from 'astro:content';

const slug = Astro.params.slug;
const posts = await getCollection('signal', ({ data }) => !data.draft);
const post = posts.find(p => p.id === slug);

if (!post) {
  return Astro.redirect('/newsroom');
}

const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={`${post.data.title} — Levy Signal`}
  description={post.data.description}
>

  <SectionShell
    id="article"
    theme="light"
    noBorder={true}
    style="padding-top: calc(4.5rem + var(--space-section-y));"
  >
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text={post.data.label} />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text={`${post.data.label} // ${dateStr.toUpperCase()}`} />
        <h1 class="headline-l helvetica-medium">
          {post.data.title}
        </h1>

        <div class="article-body helvetica-light body-text mt-12">
          <Content />
        </div>

        <div class="article-footer mt-16 border-top pt-8">
          <a href="/newsroom" class="dimension" style="display: inline-flex;">← ALL DISPATCHES</a>
        </div>
      </div>
    </div>
  </SectionShell>

</BaseLayout>

<style>
  .article-body {
    max-width: 40rem;
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-variation-settings: "opsz" 100, "SOFT" 50, "WONK" 0;
    font-weight: 150;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.3;
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
    line-height: 1.7;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--space-12) 0;
  }

  .article-body :global(strong) {
    font-weight: 500;
  }

  .article-body :global(em) {
    font-style: italic;
    opacity: 0.75;
  }
</style>
