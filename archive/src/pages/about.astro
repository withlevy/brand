---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/layout/SectionShell.astro';
import VerticalLabel from '../components/typography/VerticalLabel.astro';
import DimensionLabel from '../components/typography/DimensionLabel.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="About Levy"
  description="The founding logic, strategic worldview, and operating purpose of Levy."
>

  <!-- =========================================================
       01 / FOUNDING LOGIC
       Why Levy exists. No positioning theater.
       ========================================================= -->
  <SectionShell
    id="founding"
    theme="light"
    style="padding-top: calc(4.5rem + var(--space-section-y));"
  >
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="01 / Origin" />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text="LEVY // FOUNDING LOGIC" />
        <h1 class="headline-l helvetica-medium">
          Why this exists.
        </h1>
        <p class="body-text helvetica-light mb-8">
          Levy was built on a single observation: the people most capable of
          consequential work are often the worst-served by the environments
          available to them. They have access to information, but not to the
          right context. They have networks, but not to the right people.
          They have ambition, but not to the right operating conditions.
        </p>
        <p class="body-text helvetica-light mb-8">
          Generic networks offer connection without selectivity. Consultants
          offer advice without skin in the game. Conferences offer access
          without trust. The people who move systems — who produce outlier
          outcomes at institutional scale — deserve better infrastructure
          than this.
        </p>
        <p class="body-text helvetica-light">
          Levy is the answer to that problem. An operating environment
          designed around seriousness, leverage, and the specific conditions
          that make outlier outcomes more likely.
        </p>
      </div>
    </div>
  </SectionShell>

  <!-- =========================================================
       02 / WORLDVIEW
       What Levy believes. Concrete, not abstract.
       ========================================================= -->
  <SectionShell id="worldview" theme="dark">
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="02 / Worldview" />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text="OPERATING DOCTRINE // WHAT WE BELIEVE" />
        <h2 class="headline-m helvetica-medium">
          Every era-defining accomplishment shares the same hidden architecture.
        </h2>
      </div>

      <div class="span-col-2-3 reveal delay-2 border-top pt-8 mt-16">
        <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.75rem;">
          Leverage is structural, not intuitive.
        </h3>
        <p class="helvetica-light" style="font-size: 0.9rem; line-height: 1.65;">
          Most people try to solve problems by working harder. The people who
          produce outlier outcomes are looking for the fulcrum — the place
          where a small amount of force moves a large amount of weight. Finding
          that requires institutional fluency and strategic patience that most
          environments actively discourage.
        </p>
      </div>

      <div class="span-col-4-5 reveal delay-2 border-top pt-8 mt-16">
        <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.75rem;">
          Coordination is the rarest skill.
        </h3>
        <p class="helvetica-light" style="font-size: 0.9rem; line-height: 1.65;">
          Getting serious people to move together — across institutional lines,
          in conditions of genuine uncertainty — is harder and more valuable
          than any specific technical competence. It requires trust, precision,
          and operating frameworks that most institutions don't have.
        </p>
      </div>

      <div class="span-col-2-3 reveal delay-3 border-top pt-8 mt-10">
        <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.75rem;">
          Public legitimacy is an asset.
        </h3>
        <p class="helvetica-light" style="font-size: 0.9rem; line-height: 1.65;">
          Being known — in the right rooms, by the right people, for the right
          reasons — changes what's possible. Public legitimacy isn't vanity.
          It's a force multiplier for people who are already doing serious work
          and want it to reach the scale it deserves.
        </p>
      </div>

      <div class="span-col-4-5 reveal delay-3 border-top pt-8 mt-10">
        <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.75rem;">
          Environment determines outcome.
        </h3>
        <p class="helvetica-light" style="font-size: 0.9rem; line-height: 1.65;">
          The conditions around the work — the peers you can call, the rooms
          you can enter, the frameworks available to you — determine as much
          as the work itself. Building those conditions deliberately is one of
          the highest-leverage investments a serious person can make.
        </p>
      </div>
    </div>
  </SectionShell>

  <!-- =========================================================
       03 / THE ENVIRONMENT
       The three operating contexts, briefly.
       ========================================================= -->
  <SectionShell id="environment" theme="light">
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="03 / The Environment" />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text="OPERATING CONTEXTS // LEVY ENVIRONMENT" />
        <h2 class="headline-m helvetica-medium">
          Three contexts. One coherent environment.
        </h2>
        <p class="body-text helvetica-light mb-12">
          Levy is structured across three operating contexts that work together:
          a network for serious peers, a studio for strategic design and
          intervention, and an institute for ideas that need to earn public
          legitimacy. Each context is distinct. All three are part of the
          same operating logic.
        </p>
      </div>

      <div class="span-col-2-5 reveal delay-2">
        <div class="environment-triad">
          <div class="triad-item border-top pt-6">
            <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.5rem;">The Network</h3>
            <p class="helvetica-light" style="font-size: 0.9rem; margin-bottom: 1rem;">Where serious people build together.</p>
            <a href="/network" class="dimension" style="display: inline-flex;">EXPLORE THE NETWORK →</a>
          </div>

          <div class="triad-item border-top pt-6">
            <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.5rem;">The Studio</h3>
            <p class="helvetica-light" style="font-size: 0.9rem; margin-bottom: 1rem;">Where strategy becomes architecture.</p>
            <a href="/studio" class="dimension" style="display: inline-flex;">EXPLORE THE STUDIO →</a>
          </div>

          <div class="triad-item border-top pt-6">
            <h3 class="fraunces-h3" style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0.5rem;">The Institute</h3>
            <p class="helvetica-light" style="font-size: 0.9rem; margin-bottom: 1rem;">Where ideas earn public legitimacy.</p>
            <a href="/institute" class="dimension" style="display: inline-flex;">EXPLORE THE INSTITUTE →</a>
          </div>
        </div>
      </div>
    </div>
  </SectionShell>

  <!-- =========================================================
       04 / CLOSING CTA
       ========================================================= -->
  <SectionShell id="about-cta" theme="dark" noBorder={true} noMinHeight={true}
    style="padding-bottom: var(--space-section-y);">
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="04 / Access" />
      </div>
      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text="MEMBERSHIP // JOIN THE ENVIRONMENT" />
        <h2 class="headline-m helvetica-medium">
          Ready to operate with better conditions?
        </h2>
        <Button href="/join">Join the Network</Button>
      </div>
    </div>
  </SectionShell>

</BaseLayout>

<style>
  .environment-triad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 900px) {
    .environment-triad {
      grid-template-columns: 1fr;
    }
  }
</style>
