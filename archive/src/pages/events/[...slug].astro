---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionShell from '../../components/layout/SectionShell.astro';
import VerticalLabel from '../../components/typography/VerticalLabel.astro';
import DimensionLabel from '../../components/typography/DimensionLabel.astro';
import Button from '../../components/ui/Button.astro';
import { getCollection, render } from 'astro:content';

const slug = Astro.params.slug;
const events = await getCollection('events', ({ data }) => !data.draft);
const event = events.find(e => e.id === slug);

if (!event) {
  return Astro.redirect('/events');
}

const { Content } = await render(event);
const dateStr = event.data.date.toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={`${event.data.title} — Levy Events`}
  description={event.data.description}
>

  <SectionShell
    id="event-detail"
    theme="light"
    noBorder={true}
    style="padding-top: calc(4.5rem + var(--space-section-y));"
  >
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="Event" />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text={`${event.data.type.toUpperCase()} // ${dateStr.toUpperCase()}`} />
        <h1 class="headline-l helvetica-medium">
          {event.data.title}
        </h1>

        {event.data.location && (
          <p class="helvetica-light mb-8" style="font-size: 0.9rem; opacity: 0.6;">
            {event.data.location}
          </p>
        )}

        {event.data.memberOnly && (
          <div class="dimension mb-8" style="opacity: 0.7;">MEMBER-ONLY EVENT</div>
        )}

        <div class="article-body helvetica-light body-text">
          <Content />
        </div>

        <div class="event-actions mt-16 border-top pt-8">
          {event.data.rsvpUrl ? (
            <Button href={event.data.rsvpUrl}>Register</Button>
          ) : (
            <Button href="/join">Join the Network for Access</Button>
          )}
          <a href="/events" class="dimension mt-8" style="display: inline-flex;">← ALL EVENTS</a>
        </div>
      </div>
    </div>
  </SectionShell>

</BaseLayout>

<style>
  .article-body {
    max-width: 40rem;
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-variation-settings: "opsz" 100, "SOFT" 50, "WONK" 0;
    font-weight: 150;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.3;
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-6);
    line-height: 1.7;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--space-12) 0;
  }

  .article-body :global(strong) {
    font-weight: 500;
  }

  .article-body :global(em) {
    font-style: italic;
    opacity: 0.75;
  }

  .event-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
