---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/layout/SectionShell.astro';
import VerticalLabel from '../components/typography/VerticalLabel.astro';
import DimensionLabel from '../components/typography/DimensionLabel.astro';
---

<BaseLayout
  title="Log In — Levy"
  description="Access your Levy Network account."
>

  <!-- =========================================================
       LOGIN SHELL
       Sparse. Infrastructural. Designed for Outseta embed.
       ========================================================= -->
  <SectionShell
    id="login"
    theme="light"
    noBorder={true}
    noMinHeight={true}
    style="padding-top: calc(4.5rem + var(--space-section-y)); padding-bottom: calc(var(--space-section-y) * 1.5); min-height: 100vh;"
  >
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="Account" />
      </div>

      <div class="span-col-2-3 reveal delay-1">
        <DimensionLabel text="LEVY NETWORK // ACCOUNT ACCESS" />
        <h1 class="headline-m helvetica-medium">
          Log in.
        </h1>
        <p class="helvetica-light mb-12" style="font-size: var(--type-body); max-width: 28rem;">
          Access your Levy Network account, membership details, and
          member-only resources.
        </p>

        <div class="login-embed">
          <div class="dimension" style="opacity: 0.35; margin-bottom: var(--space-8);">
            AUTHENTICATION // SECURE LOGIN
          </div>
          <div data-o-auth="1" data-mode="embed" data-widget-mode="login"></div>
        </div>

        <div class="login-footer mt-12">
          <a href="/join" class="dimension" style="display: inline-flex; opacity: 0.5;">
            NOT YET A MEMBER? JOIN THE NETWORK →
          </a>
        </div>
      </div>
    </div>
  </SectionShell>

</BaseLayout>

<style>
  .login-embed {
    border-top: var(--heavy-line);
    padding-top: var(--space-8);
    max-width: 28rem;
  }

  .login-footer {
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-6);
  }
</style>
