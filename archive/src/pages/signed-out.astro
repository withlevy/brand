---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/layout/SectionShell.astro';
import VerticalLabel from '../components/typography/VerticalLabel.astro';
import DimensionLabel from '../components/typography/DimensionLabel.astro';
---

<BaseLayout
  title="Signed Out — Levy"
  description="Your Levy Network session has ended."
>

  <SectionShell
    id="signed-out"
    theme="light"
    noBorder={true}
    noMinHeight={true}
    style="padding-top: calc(4.5rem + var(--space-section-y)); padding-bottom: calc(var(--space-section-y) * 1.5); min-height: 100vh;"
  >
    <div class="nasa-grid">
      <div class="span-col-1 reveal">
        <VerticalLabel text="Session" />
      </div>

      <div class="span-col-2-4 reveal delay-1">
        <DimensionLabel text="LEVY NETWORK // SESSION TERMINATED" />
        <h1 class="headline-m helvetica-medium">
          You're signed out.
        </h1>
        <p class="helvetica-light mb-12" style="font-size: var(--type-body); max-width: 32rem;">
          Your session has ended. The network is still here when you're ready
          to return.
        </p>

        <div class="signed-out-actions">
          <a href="/login" class="btn">Log Back In</a>
          <a href="/" class="dimension" style="display: inline-flex; align-items: center; opacity: 0.6;">
            RETURN TO HOME →
          </a>
        </div>
      </div>
    </div>
  </SectionShell>

</BaseLayout>

<style>
  .signed-out-actions {
    border-top: var(--heavy-line);
    padding-top: var(--space-8);
    display: flex;
    gap: var(--space-8);
    align-items: center;
    flex-wrap: wrap;
  }
</style>
