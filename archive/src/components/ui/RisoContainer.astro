---
interface Props {
  interactive?: boolean;
  id?: string;
  class?: string;
}

const { interactive = false, id, class: className = '' } = Astro.props;
---

<div
  class:list={['riso-container', className]}
  id={id}
  data-riso-interactive={interactive ? '' : undefined}
>
  <div class="riso-mask"  aria-hidden="true"></div>
  <div class="fluid-ink"  aria-hidden="true"></div>
</div>

<script>
  // Runs once per page (Astro deduplicates bundled scripts).
  // Activates mouse-tracking ink on any container with [data-riso-interactive].
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion && window.innerWidth > 900) {
    document.querySelectorAll<HTMLElement>('.riso-container[data-riso-interactive]').forEach(container => {
      const ink = container.querySelector<HTMLElement>('.fluid-ink');
      if (!ink) return;

      container.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        ink.style.transform = `translate3d(${x - rect.width * 0.5}px, ${y - rect.height * 0.5}px, 0)`;
      });

      container.addEventListener('mouseleave', () => {
        ink.style.transform = 'translate3d(-50%, -50%, 0)';
      });
    });
  }
</script>
