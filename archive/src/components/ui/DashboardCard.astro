---
interface Props {
  label?: string;
  title?: string;
  meta?: string;
  noBorder?: boolean;
  class?: string;
}

const { label, title, meta, noBorder = false, class: className = '' } = Astro.props;
---

<div class:list={['dash-card', noBorder && 'dash-card--no-border', className]}>
  <div>
    {label && <div class="dimension">{label}</div>}
    {title && <h3 class="fraunces-h3" style="font-size: 1.25rem;">{title}</h3>}
    <slot />
  </div>
  {meta && <div class="dash-meta">{meta}</div>}
</div>
