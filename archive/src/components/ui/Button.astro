---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { href, type = 'button', class: className = '' } = Astro.props;
---

{href ? (
  <a href={href} class:list={['btn', className]}>
    <slot />
  </a>
) : (
  <button type={type} class:list={['btn', className]}>
    <slot />
  </button>
)}
