{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levy-website",
  "compatibility_date": "2025-09-27",
  // Cloudflare Pages project. The build stages the single, self-contained
  // index.html into `dist/`, which Pages serves directly (no Functions).
  // In the Pages dashboard, set Build command = `npm run build`,
  // Build output directory = `dist`, and Framework preset = None.
  "pages_build_output_dir": "./dist"
}
