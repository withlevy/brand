{
  "name": "levy-website",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Levy — minimal one-page site (self-contained index.html).",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.html dist/index.html",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.73.0"
  }
}
